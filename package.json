{
  "name": "@loipv/nestjs-nats",
  "version": "0.1.0",
  "description": "Decorator-driven NATS and JetStream integration for NestJS: subscribers, consumers, services, CloudEvents, retry/DLQ, idempotency, batching, OpenTelemetry, health checks and testing utilities",
  "keywords": [
    "nestjs",
    "nats",
    "jetstream",
    "microservices",
    "messaging",
    "cloudevents",
    "opentelemetry",
    "dead-letter-queue",
    "idempotency"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loipv/nestjs-nats.git"
  },
  "homepage": "https://github.com/loipv/nestjs-nats#readme",
  "bugs": {
    "url": "https://github.com/loipv/nestjs-nats/issues"
  },
  "author": "loipv",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "default": "./dist/otel/index.js"
    },
    "./health": {
      "types": "./dist/health/index.d.ts",
      "default": "./dist/health/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./kv": {
      "types": "./dist/kv/index.d.ts",
      "default": "./dist/kv/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prebuild": "node --input-type=commonjs -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "lint": "biome check .",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "docs:check": "npm run build && npm run docs:check:only",
    "docs:check:only": "node scripts/check-docs.mjs",
    "example:check": "npm run build && cd examples/orders && rm -rf node_modules/@loipv && npm install --no-audit --no-fund && npm run typecheck && npm test",
    "check:pack": "node scripts/check-pack.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "changeset publish",
    "check:pkg": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build && npm run check:pack && npm run check:pkg && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@nats-io/jetstream": "^3.0.0",
    "@nats-io/kv": "^3.0.0",
    "@nats-io/services": "^3.0.0",
    "@nats-io/transport-node": "^3.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/terminus": "^11.0.0 || ^12.0.0",
    "@opentelemetry/api": "^1.9.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nats-io/kv": {
      "optional": true
    },
    "@nestjs/terminus": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/kv": "^3.4.0",
    "@nats-io/services": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/testing": "^12.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@swc/core": "^1.16.13",
    "@types/node": "^22.20.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "testcontainers": "^12.2.0",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
